  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "payloadprobe",
    "prometheus",
    "starter"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "payloadprobe",
          "value": "payloadprobe"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(payloadprobe_response_catalog_size, job)",
        "hide": 0,
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": {
          "query": "label_values(payloadprobe_response_catalog_size, job)",
          "refId": "PrometheusVariableQueryEditor-Job"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
